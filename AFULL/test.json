[
    {
        "dataset": "Loghub",
        "path": "Logs/Loghub/",
        "config": [
            {
                "log_name": "Proxifier",
                "log_format": "[<Time>] <Program> - <Content>",
                "regex": [
                    "<\\d+\\ssec",
                    "([\\w-]+\\.)+[\\w-]+(:\\d+)?",
                    "\\d{2}:\\d{2}(:\\d{2})*",
                    "[KGTM]B"
                ], 
                "type": ["2k", "full"]
            },
            {
                "log_name": "HDFS",
                "log_format": "<Date> <Time> <Pid> <Level> <Component>: <Content>",
                "regex": [
                    "blk_-?\\d+",
                    "(\\d+\\.){3}\\d+(:\\d+)?"
                ], 
                "type": ["2k", "full"]
            }
        ]
    },
